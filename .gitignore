.worktrees/
.fiddle/

# Bean tracker state and archived plans (kept locally, excluded from repo)
.beans/
.archive/
docs/plans/
docs/specs/

# Evaluation artifacts (temporary JSON files produced during develop loop)
scorecard*.json
verdict.json
history*.json
convergence.json
criteria.json
disagreements*.json

# Develop-loop verdict-gate marker
.fiddle/

# Generated by git-hooks.nix
.pre-commit-config.yaml

# Rust build artifacts
/target

# devenv shell state
.devenv/
.devenv.flake.nix

# Local credentials, loaded by direnv's dotenv_if_exists in .envrc. Never
# committed and never referenced from fiddle.toml, which holds the name of an
# environment variable rather than a resolved value.
.env
.env.*
!.env.example
