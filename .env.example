# Copy to .env and fill in. .env is gitignored; never commit a resolved value.
# fiddle.toml references only the NAME of this variable, never its value.
LITELLM_API_KEY=

# M2's GitHub effects. A fine-grained token scoped to exactly one repository —
# peel/fiddle-effects-acceptance — with Contents, Pull requests and Actions at
# read-and-write plus Metadata read-only. Deliberately not a classic `repo`
# token: this one is structurally incapable of touching peel/fiddle.
#
# This covers the local lane only. The dispatch-only Actions lane reads the
# same value from the FIDDLE_EFFECTS_TOKEN repository secret, because a local
# file never reaches a runner.
FIDDLE_GITHUB_TOKEN=
