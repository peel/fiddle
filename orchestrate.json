{
  "providers": {
    "codex": {
      "command": "codex exec",
      "flags": "--json -s read-only",
      "extract": "codex-jsonl"
    },
    "phases": {
      "discover": [
        "codex"
      ],
      "define": [
        "codex"
      ],
      "develop": [],
      "develop_holistic": [
        "codex"
      ],
      "deliver": [
        "codex"
      ]
    },
    "timeout": {
      "attended": 120,
      "unattended": 90
    }
  },
  "evaluators": {
    "attended": false,
    "max_dispatches_per_task": 16,
    "domains": {
      "general": {
        "template": "evaluator-general",
        "providers": [
          "claude",
          "codex"
        ],
        "calibration": "docs/evaluator-calibration-general.md"
      },
      "infrastructure": {
        "template": "evaluator-infrastructure",
        "providers": [
          "claude",
          "codex"
        ]
      }
    },
    "holistic": {
      "providers": [
        "claude"
      ],
      "max_iterations": 8
    }
  },
  "models": {
    "phases": {
      "discover": "default",
      "define": "default",
      "develop": "default",
      "deliver": "default"
    },
    "roles": {
      "brainstorm": "default",
      "panel": "default",
      "implementer": "default",
      "evaluator": "default",
      "holistic": "default",
      "deliver": "default"
    }
  },
  "plans": {}
}
